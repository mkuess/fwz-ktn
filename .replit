modules = ["php-8.2", "nodejs-20", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan serve --host=0.0.0.0 --port=5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["php", "artisan", "serve", "--host=0.0.0.0", "--port=5000"]
build = ["bash", "-c", "npm run build && php artisan migrate --force"]

[userenv]

[userenv.shared]
SESSION_SAME_SITE = "lax"
SESSION_SECURE_COOKIE = "true"
MAIL_FROM_ADDRESS = "fwz-ktn@oja.at"
MAIL_FROM_NAME = "Freiwilligenzentrum Kärnten"
MAIL_HOST = "email.oja.at"
MAIL_MAILER = "smtp"
MAIL_PORT = "587"
MAIL_TIMEOUT = "10"
MAIL_USERNAME = "fwz-ktn@oja.at"
